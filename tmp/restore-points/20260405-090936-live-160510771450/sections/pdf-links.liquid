{% render 'section-border-accent' %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .pdf-links-{{ section.id }} .pdf-links__header {
    margin-bottom: 2.4rem;
    text-align: {{ section.settings.heading_alignment }};
  }

  .pdf-links-{{ section.id }} .pdf-links__title {
    margin: 0;
  }

  .pdf-links-{{ section.id }} .pdf-links__intro {
    margin-top: 1.2rem;
  }

  .pdf-links-{{ section.id }} .pdf-links__intro > *:first-child {
    margin-top: 0;
  }

  .pdf-links-{{ section.id }} .pdf-links__intro > *:last-child {
    margin-bottom: 0;
  }

  .pdf-links-{{ section.id }} .pdf-links__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0, 1fr));
    gap: {{ section.settings.grid_gap | divided_by: 10.0 }}rem;
  }

  @media screen and (min-width: 990px) {
    .pdf-links-{{ section.id }} .pdf-links__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }

  .pdf-links-{{ section.id }} .pdf-links__item {
    min-width: 0;
  }

  .pdf-links-{{ section.id }} .pdf-links__button {
    width: 100%;
    gap: 0.8rem;
    text-align: center;
    white-space: normal;
  }

  .pdf-links-{{ section.id }} .pdf-links__button--vertical {
    flex-direction: column;
  }

  .pdf-links-{{ section.id }} .pdf-links__button--horizontal {
    flex-direction: row;
  }

  .pdf-links-{{ section.id }} .pdf-links__button-icon {
    flex: 0 0 auto;
    width: 1.8rem;
    height: 1.8rem;
  }

  .pdf-links-{{ section.id }} .pdf-links__button-label {
    display: inline-block;
  }

  .pdf-links-{{ section.id }} .pdf-links__empty {
    margin: 0;
    padding: 2rem;
    border: 0.1rem dashed rgba(var(--color-foreground), 0.3);
    text-align: center;
    opacity: 0.75;
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient pdf-links-{{ section.id }}">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="pdf-links__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="pdf-links__title {{ section.settings.heading_size }}">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.intro != blank -%}
          <div class="pdf-links__intro rte">
            {{ section.settings.intro }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pdf-links__grid">
        {%- for block in section.blocks -%}
          <div class="pdf-links__item" {{ block.shopify_attributes }}>
            <a
              {% if block.settings.pdf_url != blank %}
                href="{{ block.settings.pdf_url }}"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
              class="button {% if block.settings.button_style == 'secondary' %}button--secondary{% else %}button--primary{% endif %} pdf-links__button pdf-links__button--{{ section.settings.button_layout }}"
            >
              <svg class="pdf-links__button-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M14 2v5h5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M8.5 14.25h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M8.5 17.25h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              <span class="pdf-links__button-label">
                {{ block.settings.button_label | default: 'Download PDF' | escape }}
              </span>
            </a>
          </div>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="pdf-links__empty">
        Add PDF link blocks here. Upload the file in Shopify Files, then paste that file URL into the block.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "PDF Links",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "max_blocks": 24,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "PDF Links",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Extra large"
        }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro copy"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left",
      "label": "Header alignment"
    },
    {
      "type": "select",
      "id": "button_layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal",
      "label": "Button layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Columns per row"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1",
      "label": "Mobile columns"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 30,
      "step": 2,
      "default": 12,
      "label": "Grid gap"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "paragraph",
      "content": "Shopify does not provide a native PDF upload picker in section blocks. Upload the PDF in Content > Files, then paste that file URL into each block."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Bottom padding"
    }
  ],
  "blocks": [
    {
      "type": "pdf_link",
      "name": "PDF button",
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Download PDF",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "pdf_url",
          "label": "PDF file URL"
        },
        {
          "type": "select",
          "id": "button_style",
          "options": [
            {
              "value": "primary",
              "label": "Primary"
            },
            {
              "value": "secondary",
              "label": "Secondary"
            }
          ],
          "default": "primary",
          "label": "Button style"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "default": true,
          "label": "Open in a new tab"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDF Links",
      "blocks": [
        {
          "type": "pdf_link"
        }
      ]
    }
  ]
}
{% endschema %}
