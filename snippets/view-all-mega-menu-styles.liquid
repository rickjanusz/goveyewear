  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(1) { transition-delay: 0s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(2) { transition-delay: 0.05s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(3) { transition-delay: 0.1s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(4) { transition-delay: 0.15s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(5) { transition-delay: 0.2s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(6) { transition-delay: 0.25s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(7) { transition-delay: 0.3s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(8) { transition-delay: 0.35s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(9) { transition-delay: 0.4s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(10) { transition-delay: 0.45s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(11) { transition-delay: 0.5s; }
  .section-{{ menu_id }}-view-all-menu-stage .section-{{ menu_id }}-view-all-menu-card:nth-child(12) { transition-delay: 0.55s; }

  .section-{{ menu_id }}-view-all-menu-stage.is-transitioning-out .section-{{ menu_id }}-view-all-menu-card {
    opacity: 0;
    transform: scale(0.96);
  }

  .section-{{ menu_id }}-view-all-menu-stage.is-transitioning-in .section-{{ menu_id }}-view-all-menu-card {
    opacity: 0;
    transform: scale(0.96);
  }

  .section-{{ menu_id }}-view-all-menu-stage.is-transitioning-in.is-active .section-{{ menu_id }}-view-all-menu-card.is-visible {
    opacity: 1;
    transform: scale(1);
  }

  .section-{{ menu_id }}-view-all-menu-frame,
  .section-{{ menu_id }}-view-all-menu-version-card {
    display: block;
    color: inherit;
    text-decoration: none;
    padding: 0;
    box-shadow: inset 0 0 0 3px transparent;
  }

  .section-{{ menu_id }}-view-all-menu-frame-figure {
    margin: 0;
  }

  .section-{{ menu_id }}-view-all-menu-frame-image-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1;
