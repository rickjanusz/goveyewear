{%- liquid
  assign menu_id = menu_id | default: section.id
-%}

.section-{{ menu_id }}-view-all-wrap {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 1.2rem;
  flex-wrap: wrap;
  overflow: visible;
}

.section-{{ menu_id }}-view-all-trigger,
.section-{{ menu_id }}-view-all-detail-trigger {
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.section-{{ menu_id }}-view-all-detail-trigger::before {
  content: '';
  position: absolute;
  inset: 0;
  background-color: currentColor;
  opacity: 0.15;
  transform: scaleX(0);
  transform-origin: left center;
  pointer-events: none;
  z-index: 0;
}

.section-{{ menu_id }}-view-all-detail-trigger.is-charging::before {
  animation: detail-trigger-fill 1s linear forwards;
}

.section-{{ menu_id }}-view-all-detail-trigger > * {
  position: relative;
  z-index: 1;
}

.section-{{ menu_id }}-view-all-menu {
  display: none;
}

@media screen and (min-width: 990px) {
  .section-{{ menu_id }}-view-all-wrap--has-menu {
    position: static;
  }

  .section-{{ menu_id }}-view-all-menu.is-open {
    display: block;
  }

  .section-{{ menu_id }}-view-all-menu {
    position: fixed;
    inset: 0;
    display: none;
    width: 100vw;
    height: 100dvh;
    min-height: 100dvh;
    padding: 0;
    border: 0;
    background: #ffffff;
    box-shadow: none;
    overflow-y: auto;
    overscroll-behavior: contain;
    text-align: left;
    z-index: 2147483647;
  }

  .section-{{ menu_id }}-view-all-menu-shell {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    max-width: 192rem;
    margin: 0 auto;
  }

  .section-{{ menu_id }}-view-all-menu-topbar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1.6rem;
    padding: 2.4rem 4rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    background: #ffffff;
  }

  .section-{{ menu_id }}-view-all-menu-topbar-start,
  .section-{{ menu_id }}-view-all-menu-topbar-center,
  .section-{{ menu_id }}-view-all-menu-topbar-end {
    display: flex;
    align-items: center;
  }

  .section-{{ menu_id }}-view-all-menu-topbar-center {
    justify-content: center;
  }

  .section-{{ menu_id }}-view-all-menu-topbar-end {
    justify-content: flex-end;
  }

  .section-{{ menu_id }}-view-all-menu-topbar-title {
    margin: 0;
    font-size: 2.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #111111;
  }

  .section-{{ menu_id }}-view-all-menu-close {
    background: none;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 999px;
    width: 3.6rem;
    height: 3.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111111;
  }

  .section-{{ menu_id }}-view-all-menu-close:hover,
  .section-{{ menu_id }}-view-all-menu-close:focus-visible {
    border-color: rgba(0, 0, 0, 0.4);
  }

  .section-{{ menu_id }}-view-all-menu-grid {
    padding: 3.2rem 4rem 4.8rem;
  }

  .section-{{ menu_id }}-view-all-menu-frames {
    position: relative;
  }

  .section-{{ menu_id }}-view-all-menu-stage {
    display: none;
  }

  .section-{{ menu_id }}-view-all-menu-stage.is-active {
    display: block;
  }

  .section-{{ menu_id }}-view-all-menu-stage--frames.is-active {
