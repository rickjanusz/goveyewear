  .section-{{ menu_id }}-view-all-menu-frame:hover .section-{{ menu_id }}-view-all-menu-frame-title,
  .section-{{ menu_id }}-view-all-menu-frame:focus-visible .section-{{ menu_id }}-view-all-menu-frame-title {
