{%- liquid
  assign carousel_limit = 15
  if is_brand_collection_template
    assign carousel_limit = total_products
  endif

  assign products_to_display = total_products
  if products_to_display > carousel_limit
    assign products_to_display = carousel_limit
  endif

  assign more_in_collection = false
  if total_products > products_to_display
    assign more_in_collection = true
  endif

  assign columns_mobile_int = columns_mobile | plus: 0
  assign show_mobile_slider = false
  if swipe_on_mobile and products_to_display > columns_mobile_int
    assign show_mobile_slider = true
  endif

  assign show_desktop_slider = false
  if enable_desktop_slider and products_to_display > columns_desktop
    assign show_desktop_slider = true
  endif
-%}
{{- carousel_limit -}}||{{- products_to_display -}}||{{- more_in_collection -}}||{{- show_mobile_slider -}}||{{- show_desktop_slider -}}
