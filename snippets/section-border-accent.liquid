{%- if section.settings.border_accent_top != blank or section.settings.border_accent_bottom != blank -%}
  {%- assign border_accent_height = section.settings.border_accent_height | default: 60 | plus: 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      position: relative;
      isolation: isolate;
    }

    #shopify-section-{{ section.id }}::before,
    #shopify-section-{{ section.id }}::after {
      content: '';
      position: absolute;
      left: 0;
      width: 100%;
      height: {{ border_accent_height }}px;
      pointer-events: none;
      z-index: 50;
      background-repeat: repeat-x;
      background-position: center;
      background-size: auto 100%;
    }

    #shopify-section-{{ section.id }}::before {
      top: 0;
      {%- if section.settings.border_accent_top != blank -%}
        background-image: url('{{ section.settings.border_accent_top | image_url: width: 1920 }}');
      {%- else -%}
        display: none;
      {%- endif -%}
    }

    #shopify-section-{{ section.id }}::after {
      bottom: 0;
      {%- if section.settings.border_accent_bottom != blank -%}
        background-image: url('{{ section.settings.border_accent_bottom | image_url: width: 1920 }}');
      {%- else -%}
        display: none;
      {%- endif -%}
    }

  {%- endstyle -%}
{%- endif -%}

{% render 'section-corner-accent' %}
