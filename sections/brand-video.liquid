{% render 'section-border-accent' %}

{{ 'component-video.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .brand-video-{{ section.id }} {
    position: relative;
  }

  .brand-video-{{ section.id }} .brand-video__inner {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .brand-video-{{ section.id }} .brand-video__header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 2rem;
  }

  .brand-video-{{ section.id }} .brand-video__preheader {
    margin: 0 0 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .brand-video-{{ section.id }} .brand-video__heading {
    margin: 0 0 1rem;
  }

  .brand-video-{{ section.id }} .brand-video__subheader {
    margin: 0 0 1rem;
  }

  .brand-video-{{ section.id }} .brand-video__paragraph {
    margin: 0;
  }

  @media screen and (min-width: 750px) {
    .brand-video-{{ section.id }} .brand-video__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="brand-video-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width brand-video__inner">
    {%- if section.settings.preheader != blank or section.settings.heading != blank or section.settings.subheader != blank or section.settings.paragraph != blank -%}
      <header class="brand-video__header">
        {%- if section.settings.preheader != blank -%}
          <p class="brand-video__preheader caption">{{ section.settings.preheader | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="brand-video__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheader != blank -%}
          <h3 class="brand-video__subheader {{ section.settings.subheading_size }}">{{ section.settings.subheader | escape }}</h3>
        {%- endif -%}
        {%- if section.settings.paragraph != blank -%}
          <div class="brand-video__paragraph rte">{{ section.settings.paragraph }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?playsinline=1&rel=0&modestbranding=1"
          title="{{ section.settings.heading | default: 'Brand video' | escape }}"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          style="width:100%;aspect-ratio:16/9;border:0;display:block;"
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
          title="{{ section.settings.heading | default: 'Brand video' | escape }}"
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          style="width:100%;aspect-ratio:16/9;border:0;display:block;"
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.cover_image != blank -%}
      {{ section.settings.cover_image | image_url: width: 1920 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920', alt: section.settings.heading, style: 'width:100%;height:auto;display:block;' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ]
    },
    {
      "type": "text",
      "id": "preheader",
      "label": "Preheader"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Header",
      "default": "Brand video"
    },
    {
      "type": "text",
      "id": "subheader",
      "label": "Subheader"
    },
    {
      "type": "richtext",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Header size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "select",
      "id": "subheading_size",
      "label": "Subheader size",
      "default": "h3",
      "options": [
        { "value": "h4", "label": "Small" },
        { "value": "h3", "label": "Medium" },
        { "value": "h2", "label": "Large" }
      ]
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "Video URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Bottom padding"
    },
    {
      "type": "image_picker",
      "id": "border_accent_top",
      "label": "Border Accent Top"
    },
    {
      "type": "image_picker",
      "id": "border_accent_bottom",
      "label": "Border Accent Bottom"
    },
    {
      "type": "range",
      "id": "border_accent_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "label": "Border Accent Height"
    },
    {
      "type": "header",
      "content": "Corner Accents"
    },
    {
      "type": "select",
      "id": "corner_accent_image_mode",
      "label": "Corner image source",
      "default": "all",
      "options": [
        { "value": "all", "label": "One image for all corners" },
        { "value": "individual", "label": "Different image per corner" }
      ]
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_all",
      "label": "Corner image (all)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'all' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_top_left",
      "label": "Corner image (top left)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_top_right",
      "label": "Corner image (top right)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_bottom_left",
      "label": "Corner image (bottom left)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_bottom_right",
      "label": "Corner image (bottom right)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "range",
      "id": "corner_accent_size",
      "min": 8,
      "max": 108,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Corner size"
    },
    {
      "type": "range",
      "id": "corner_accent_offset_x",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Corner horizontal offset"
    },
    {
      "type": "range",
      "id": "corner_accent_offset_y",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Corner vertical offset"
    },
    {
      "type": "checkbox",
      "id": "corner_accent_random_rotation",
      "default": false,
      "label": "Randomize corner rotation"
    },
    {
      "type": "range",
      "id": "corner_accent_rotation_min",
      "min": -45,
      "max": 0,
      "step": 1,
      "unit": "deg",
      "default": -12,
      "label": "Rotation min"
    },
    {
      "type": "range",
      "id": "corner_accent_rotation_max",
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "deg",
      "default": 12,
      "label": "Rotation max"
    }
  ],
  "presets": [
    {
      "name": "Brand Video"
    }
  ]
}
{% endschema %}
