{% render 'section-border-accent' %}

{{ 'component-video.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .brand-video-{{ section.id }} {
    position: relative;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .brand-video-{{ section.id }} .brand-video__media {
    width: 100%;
  }

  .brand-video-{{ section.id }} .brand-video__embed,
  .brand-video-{{ section.id }} .brand-video__file,
  .brand-video-{{ section.id }} .brand-video__fallback-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    border: 0;
  }

  .brand-video-{{ section.id }} .brand-video__file,
  .brand-video-{{ section.id }} .brand-video__fallback-image {
    height: auto;
  }

  .brand-video-{{ section.id }} .brand-video__file {
    background: transparent;
  }

  @media screen and (min-width: 750px) {
    .brand-video-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section class="brand-video-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="brand-video__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: class: 'brand-video__file', autoplay: true, loop: true, muted: true, controls: false }}
    {%- elsif section.settings.video_url != blank -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          class="brand-video__embed"
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?playsinline=1&rel=0&modestbranding=1"
          title="Brand video"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          class="brand-video__embed"
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}"
          title="Brand video"
          loading="lazy"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      {%- endif -%}
    {%- elsif section.settings.cover_image != blank -%}
      {{ section.settings.cover_image | image_url: width: 1920 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1920', alt: 'Brand video', class: 'brand-video__fallback-image' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand Video",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "background-1",
      "options": [
        { "value": "accent-1", "label": "Accent 1" },
        { "value": "accent-2", "label": "Accent 2" },
        { "value": "background-1", "label": "Background 1" },
        { "value": "background-2", "label": "Background 2" },
        { "value": "inverse", "label": "Inverse" }
      ]
    },
    {
      "type": "video",
      "id": "video",
      "label": "Hosted video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "accept": ["youtube", "vimeo"],
      "label": "External video URL"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Fallback image"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Top padding"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40,
      "label": "Bottom padding"
    },
    {
      "type": "image_picker",
      "id": "border_accent_top",
      "label": "Border Accent Top"
    },
    {
      "type": "image_picker",
      "id": "border_accent_bottom",
      "label": "Border Accent Bottom"
    },
    {
      "type": "range",
      "id": "border_accent_height",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 60,
      "label": "Border Accent Height"
    },
    {
      "type": "header",
      "content": "Corner Accents"
    },
    {
      "type": "select",
      "id": "corner_accent_image_mode",
      "label": "Corner image source",
      "default": "all",
      "options": [
        { "value": "all", "label": "One image for all corners" },
        { "value": "individual", "label": "Different image per corner" }
      ]
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_all",
      "label": "Corner image (all)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'all' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_top_left",
      "label": "Corner image (top left)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_top_right",
      "label": "Corner image (top right)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_bottom_left",
      "label": "Corner image (bottom left)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "image_picker",
      "id": "corner_accent_image_bottom_right",
      "label": "Corner image (bottom right)",
      "visible_if": "{{ section.settings.corner_accent_image_mode == 'individual' }}"
    },
    {
      "type": "range",
      "id": "corner_accent_size",
      "min": 8,
      "max": 108,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Corner size"
    },
    {
      "type": "range",
      "id": "corner_accent_offset_x",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Corner horizontal offset"
    },
    {
      "type": "range",
      "id": "corner_accent_offset_y",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Corner vertical offset"
    },
    {
      "type": "checkbox",
      "id": "corner_accent_random_rotation",
      "default": false,
      "label": "Randomize corner rotation"
    },
    {
      "type": "range",
      "id": "corner_accent_rotation_min",
      "min": -45,
      "max": 0,
      "step": 1,
      "unit": "deg",
      "default": -12,
      "label": "Rotation min"
    },
    {
      "type": "range",
      "id": "corner_accent_rotation_max",
      "min": 0,
      "max": 45,
      "step": 1,
      "unit": "deg",
      "default": 12,
      "label": "Rotation max"
    }
  ],
  "presets": [
    {
      "name": "Brand Video"
    }
  ]
}
{% endschema %}
